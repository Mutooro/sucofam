# ============================================================
#  SUCOFAM — Apache .htaccess
#  Works with vite-ssg pre-rendered static output.
#  Each route has its own .html file; this file handles:
#   - Clean URLs (strip .html extension)
#   - SPA fallback for any route not pre-rendered
#   - HTTPS enforcement
#   - Long-term caching for hashed assets
#   - Security headers
# ============================================================

Options -Indexes
Options +FollowSymLinks

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ── 1. Force HTTPS ──────────────────────────────────────
  # Uncomment the two lines below once SSL is active on the server.
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ── 2. Remove trailing slash (except root) ───────────────
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)/$ /$1 [L,R=301]

  # ── 3. Serve pre-rendered .html files for clean URLs ─────
  #  e.g.  /programs  → /programs.html
  #        /about     → /about.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/%{REQUEST_URI}.html -f
  RewriteRule ^(.*)$ /$1.html [L]

  # ── 4. SPA fallback ──────────────────────────────────────
  #  Any URL that didn't match a file or pre-rendered page
  #  falls back to index.html so the Vue router handles it.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /index.html [L]
</IfModule>

# ── 5. Caching ───────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On

  # Vite assets — filenames include a content hash, so cache forever
  <FilesMatch "^.+\.[0-9a-f]{8,}\.(js|css|woff2?|ttf|eot|svg|png|jpe?g|gif|webp|ico)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML pages — always revalidate so fresh content is picked up
  <FilesMatch "\.(html)$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Fonts
  <FilesMatch "\.(woff2?|ttf|eot|otf)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Images and media
  <FilesMatch "\.(jpe?g|png|gif|webp|svg|ico)$">
    ExpiresDefault "access plus 6 months"
    Header set Cache-Control "public, max-age=15552000"
  </FilesMatch>
</IfModule>

# ── 6. Compression (gzip) ────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml text/xml image/svg+xml
</IfModule>

# ── 7. Security headers ──────────────────────────────────────
<IfModule mod_headers.c>
  # Prevent MIME-type sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Prevent clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"

  # XSS protection (legacy browsers)
  Header always set X-XSS-Protection "1; mode=block"

  # Referrer policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Remove server signature
  Header always unset Server
  Header always unset X-Powered-By
</IfModule>

# ── 8. Correct MIME types ────────────────────────────────────
<IfModule mod_mime.c>
  AddType application/javascript          .js .mjs
  AddType text/css                        .css
  AddType image/svg+xml                   .svg .svgz
  AddType image/webp                      .webp
  AddType font/woff                       .woff
  AddType font/woff2                      .woff2
  AddType application/vnd.ms-fontobject   .eot
  AddType font/ttf                        .ttf
  AddType font/otf                        .otf
  AddType application/json                .json
</IfModule>

# ── 9. Error documents ───────────────────────────────────────
ErrorDocument 404 /index.html
